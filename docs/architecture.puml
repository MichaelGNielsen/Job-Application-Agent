@startuml
!theme toy

package "Client Layer" {
  [Frontend (React/Vite)] as FE
}

package "API & Queue Layer" {
  [Backend (Express)] as BE
  database "Redis (BullMQ)" as REDIS
  FE -right-> BE : REST / Socket.io
  BE -down-> REDIS : Push Job
}

package "Worker & Engine Layer" {
  [Worker (Node.js)] as WRK
  [Gemini CLI] as GEMINI
  [Pandoc] as PANDOC
  [Chromium] as CHROMIUM
  
  REDIS -down-> WRK : Pull Job
  WRK -right-> GEMINI : Prompt
  WRK -down-> PANDOC : MD -> HTML
  WRK -down-> CHROMIUM : HTML -> PDF
}

folder "Storage" {
  [File System] as FS
  WRK -down-> FS : Save Docs
  BE -down-> FS : Read Docs
}

FE -[hidden]down- BE
@enduml
